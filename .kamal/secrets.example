# Copy to .kamal/secrets (gitignored) or use this pattern as the live secrets file.
# Never put raw PEMs / HF tokens in git.

SECRETS=$(kamal secrets fetch --adapter 1password --account CNCYFLWUMZHE7MBS5AAOOSTLTI --from "MOAB/Production" CLOUDFLARE_SSL_CERT_PEM CLOUDFLARE_SSL_KEY_PEM)
CLOUDFLARE_SSL_CERT_PEM=$(kamal secrets extract CLOUDFLARE_SSL_CERT_PEM ${SECRETS})
CLOUDFLARE_SSL_KEY_PEM=$(kamal secrets extract CLOUDFLARE_SSL_KEY_PEM ${SECRETS})

AWS_ECR_PASSWORD=$(aws ecr get-login-password --region ap-southeast-2 --profile default)

# Hugging Face read token — export in shell before deploy (gated weights):
#   export HF_TOKEN=hf_...
if [ -z "${HF_TOKEN:-}" ]; then
  echo "Warning: HF_TOKEN not set — first boot cannot pull gated weights." >&2
fi
